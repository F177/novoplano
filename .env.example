# Supabase (Postgres + Auth)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Cloudflare R2 (storage de mídia, S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# RunPod Serverless (produção, Fase 4) — um endpoint por grupo, ver /runpod
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_AUDIO=
RUNPOD_ENDPOINT_LLM=
RUNPOD_ENDPOINT_TTS=

# Hugging Face (modelos com termos aceitos, ex. pyannote)
HF_TOKEN=

# Pod de desenvolvimento via SSH (ver scripts/pod_runner.py)
POD_HOST=
POD_PORT=
POD_USER=root
POD_SSH_KEY_PATH=
POD_WORKSPACE=
# Opcionais — python de cada venv montado por scripts/pod_setup.sh.
# Default: /root/venvs/{asr,llm,tts}/bin/python.
POD_PYTHON_ASR=
POD_PYTHON_LLM=
POD_PYTHON_TTS=
# Opcional — libcudnn do faster-whisper não é achada sem isso (ver pod_runner.py).
POD_LD_LIBRARY_PATH_ASR=
# Opcional — cache de pesos no Pod. Default: /workspace/hf_cache.
POD_HF_HOME=

# Asaas (pagamento — PIX e boleto)
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# Sentry
SENTRY_DSN=

# App
ENVIRONMENT=development
